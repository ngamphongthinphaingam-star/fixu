# --- ใช้งานจริง (NODE_ENV=production) ---
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres.xxxx:รหัสผ่าน@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
AUTH_MODE=proxy                     # SSO ผ่าน reverse proxy ของมหาวิทยาลัย (dev ใช้ได้เฉพาะตอนพัฒนา)
PROXY_SECRET=ใส่สตริงสุ่มยาว-อย่างน้อย-24-ตัวอักษร   # ต้องตรงกับที่ proxy ส่งใน header X-Proxy-Secret
PROXY_EMAIL_HEADER=x-forwarded-email
PROXY_NAME_HEADER=x-forwarded-user
ALLOWED_EMAIL_DOMAIN=ชื่อโดเมนมหาวิทยาลัย.ac.th
ADMIN_EMAILS=admin1@ชื่อโดเมน.ac.th
# ไม่บังคับ: เปิดผู้ช่วย AI ด้วย Gemini Free tier (ห้ามใส่คีย์ในหน้าเว็บ)
# GEMINI_API_KEY=ใส่คีย์จาก Google AI Studio
# GEMINI_MODEL=gemini-3.1-flash-lite
TRUST_PROXY=1
REOPEN_DAYS=7
RETENTION_DAYS=365
# SMTP_URL=smtps://user:pass@smtp.example.ac.th:465
# MAIL_FROM="FixU <no-reply@ชื่อโดเมน.ac.th>"
